{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "react-native-view-shot": ["./node_modules/react-native-view-shot/lib/index.d.ts"]
