# Copia este fichero a .env y rellena los valores. NUNCA subas .env a Git.
# Si añades una variable nueva, añádela aquí sin valor real.

# --- Supabase (Marina) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- API NestJS (Rubén) ---
API_PORT=3000
JWT_SECRET=
QR_SIGNING_PRIVATE_KEY=   # Ed25519, para firmar billetes QR
QR_SIGNING_PUBLIC_KEY=

# --- Chatbot (Rubén) ---
ANTHROPIC_API_KEY=

# --- Stripe, siempre modo test (Kevin) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_

# --- Face service (Kevin) ---
FACE_SERVICE_URL=http://localhost:8001

# --- GTFS worker (Marina) ---
GTFS_STATIC_URL=
GTFS_RT_URL=
GTFS_RT_POLL_SECONDS=30

# --- Frontend Expo (Alex) — solo variables públicas EXPO_PUBLIC_* ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
