# Copia este fichero a .env y rellena los valores. NUNCA subas .env a Git.
# Si añades una variable nueva, añádela aquí sin valor real.

# --- Supabase (Marina) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Secreto JWT del proyecto (Settings → API): lo usa la API para verificar tokens.
SUPABASE_JWT_SECRET=
# Postgres que lee la API (vacía = API arranca sin BD y /health lo dice).
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- API NestJS (Rubén) ---
# En algunos PCs el puerto 3000 está ocupado (AMAgent): usa 3100.
NODE_ENV=development
API_PORT=3000
# Orígenes permitidos por CORS, separados por comas (obligatorio en producción).
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
JWT_SECRET=
QR_SIGNING_PRIVATE_KEY=   # Ed25519, para firmar billetes QR
QR_SIGNING_PUBLIC_KEY=
# HMAC-SHA256 con el que la API firma los QR de billete y abono mientras no haya
# claves Ed25519. Cadena larga y aleatoria (32+ caracteres); vacía = 503 al emitir.
QR_SIGNING_SECRET=

# --- Chatbot (Rubén) ---
ANTHROPIC_API_KEY=

# --- Stripe, siempre modo test (Kevin) ---
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PUBLISHABLE_KEY=pk_test_

# --- GTFS-RT que lee la API en memoria (Rubén) ---
# Vacías = las URLs públicas de Renfe (gtfsrt.renfe.com). Solo hace falta cambiarlas en pruebas.
GTFS_RT_URL_AVLD=
GTFS_RT_URL_CERCANIAS=
# Feeds de retraso (trip_updates). Vacías = las de Renfe.
GTFS_RT_URL_RETRASOS_AVLD=
GTFS_RT_URL_RETRASOS_CERCANIAS=

# --- GTFS worker (Marina) ---
# URL del feed estático de AV/LD/MD (zip GTFS) y del CSV de estaciones.
# Vacías = las URLs públicas de Renfe que trae el importador por defecto.
GTFS_AVLD_URL=
GTFS_ESTACIONES_URL=
GTFS_STATIC_URL=
GTFS_RT_URL=
# OJO: también lo lee la API (/posiciones se refresca cada N segundos, no solo el worker).
GTFS_RT_POLL_SECONDS=30

# --- Frontend Expo (Alex) — solo variables públicas EXPO_PUBLIC_* ---
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# --- Frontend web (Alex) — solo variables públicas VITE_*. Vacía = datos simulados ---
VITE_API_URL=
# Mapa en tiempo real sin API: "simulado" fuerza los trenes simulados (plan B). Vacío = datos reales de Renfe vía /api/posiciones en Vercel.
VITE_TIEMPO_REAL=
# URL de la API solo para el mapa (Render), mientras /estaciones y /trenes no tengan base de datos.
VITE_POSICIONES_URL=
